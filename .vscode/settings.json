{
    "[luau]": {
		"editor.defaultFormatter": "JohnnyMorganz.stylua",
		"editor.detectIndentation": false,
		"editor.insertSpaces": false,
	},

    "luau-lsp.completion.autocompleteEnd": true,
	"luau-lsp.diagnostics.strictDatamodelTypes": true,
    "luau-lsp.sourcemap.enabled": false,
	"luau-lsp.types.robloxSecurityLevel": "None",
	"luau-lsp.fflags.enableNewSolver": false,
	"luau-lsp.completion.imports.enabled": false,
	"luau-lsp.completion.enableFragmentAutocomplete": true,
	"luau-lsp.fflags.override": {
		"LuauExplicitTypeInstantiationSyntax": "true",
		"LuauExplicitTypeInstantiationSupport": "true",
	},
}